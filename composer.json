{
  "name": "siratik/package-loader",
  "description": "Version coordinator for bundled WordPress packages. Ensures the newest copy of a shared package wins when several plugins vendor their own.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Built North",
      "email": "hello@builtnorth.co"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "builtnorth/coding-standards": "^1.0",
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "files": [
      "package-loader.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Siratik\\PackageLoader\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:coverage": "phpunit --coverage-html coverage",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "phpcompat": "phpcs -p . --standard=PHPCompatibility --runtime-set testVersion 8.1- --extensions=php --ignore=vendor,tests,coverage"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev",
      "dev-dev": "0.1.x-dev"
    }
  }
}
